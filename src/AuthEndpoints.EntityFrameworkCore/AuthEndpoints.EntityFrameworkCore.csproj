<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>AuthEndpoints.EntityFrameworkCore</PackageId>
    <Description>EF Core storage for AuthEndpoints: the Identity EF stores, plus the email-code, refresh-token and active-session stores and their entity mappings. Call AddEntityFrameworkStores on the AddAuthEndpoints builder.</Description>
    <!-- Released with AuthEndpoints under the same v* tag, so it keeps the same version. -->
    <Version>4.3.0</Version>
    <Authors>madeyoga</Authors>
    <Company>madeyoga</Company>
    <PackageProjectUrl>https://authendpoints.harten.id</PackageProjectUrl>
    <RepositoryUrl>https://github.com/madeyoga/AuthEndpoints</RepositoryUrl>
    <PackageTags>auth;endpoints;aspnetcore;identity;efcore;entityframeworkcore</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>True</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <InternalsVisibleTo Include="AuthEndpoints.Tests" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\AuthEndpoints\AuthEndpoints.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.2" />
  </ItemGroup>

  <Import Project="..\AuthEndpoints.DependencyRange.targets" />

</Project>
