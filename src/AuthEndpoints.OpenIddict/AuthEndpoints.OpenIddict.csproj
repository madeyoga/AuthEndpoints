<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>AuthEndpoints.OpenIddict</PackageId>
    <Description>Opt-in OAuth 2.0 and OpenID Connect authorization server for AuthEndpoints apps, built on OpenIddict. Authorization code + PKCE (S256), rotating refresh tokens, a host-rendered consent step, opt-in ID tokens, userinfo, and logout, and optional dynamic client registration.</Description>
    <Version>4.0.0-preview.1</Version>
    <Authors>madeyoga</Authors>
    <Company>madeyoga</Company>
    <PackageProjectUrl>https://authendpoints.harten.id</PackageProjectUrl>
    <RepositoryUrl>https://github.com/madeyoga/AuthEndpoints</RepositoryUrl>
    <PackageTags>auth;endpoints;aspnetcore;oauth;openiddict;pkce;identity</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>True</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <InternalsVisibleTo Include="AuthEndpoints.OpenIddict.Tests" />
  </ItemGroup>

  <!--
    Agent skill shipped in the package (https://agentskills.io). Restore puts it at
    ~/.nuget/packages/authendpoints.openiddict/<version>/skills/authendpoints-openiddict/.
  -->
  <ItemGroup>
    <None Include="..\..\skills\authendpoints-openiddict\**\*.md" Pack="true" PackagePath="skills\authendpoints-openiddict\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\AuthEndpoints\AuthEndpoints.csproj" />
    <PackageReference Include="OpenIddict.EntityFrameworkCore" Version="7.7.2" />
    <PackageReference Include="OpenIddict.Server.AspNetCore" Version="7.7.2" />
    <PackageReference Include="OpenIddict.Validation.AspNetCore" Version="7.7.2" />
    <PackageReference Include="OpenIddict.Validation.ServerIntegration" Version="7.7.2" />
  </ItemGroup>

  <Import Project="..\AuthEndpoints.DependencyRange.targets" />

</Project>
