<Project>
  <!--
    Pack writes each ProjectReference as a dependency on the referenced project's <Version>, which NuGet
    reads as a minimum. For the AuthEndpoints core, this target turns that into the range
    [core version, next major), for example [5.0.0, 6.0.0) while src/AuthEndpoints is at 5.0.0.

    - The floor is the core version the add-on was built and tested against, so restore refuses an older
      core that may lack an API the add-on calls, instead of failing at runtime.
    - The ceiling is the next major, so restore refuses a core with breaking changes.

    Both follow the referenced project's <Version>; nothing here needs editing for a release.

    A store package ranges the add-on it extends instead, by setting AuthEndpointsRangedProjects, for example
    AuthEndpoints.OpenIddict.csproj in AuthEndpoints.OpenIddict.EntityFrameworkCore. The list is
    semicolon-separated project file names; each must be a ProjectReference.
  -->
  <PropertyGroup>
    <AuthEndpointsRangedProjects Condition="'$(AuthEndpointsRangedProjects)' == ''">AuthEndpoints.csproj</AuthEndpointsRangedProjects>
  </PropertyGroup>

  <Target Name="PinAuthEndpointsDependencyRange"
          AfterTargets="_GetProjectReferenceVersions"
          BeforeTargets="GenerateNuspec">
    <ItemGroup>
      <_AuthEndpointsRangedName Include="$(AuthEndpointsRangedProjects)" />
      <_AuthEndpointsRangedReference Include="@(_ProjectReferencesWithVersions)"
                                     Condition="$([System.String]::Copy(';$(AuthEndpointsRangedProjects);').Contains(';%(Filename)%(Extension);'))" />
      <_AuthEndpointsRangedFound Include="@(_AuthEndpointsRangedReference->'%(Filename)%(Extension)')" />
      <_AuthEndpointsRangedMissing Include="@(_AuthEndpointsRangedName)" Exclude="@(_AuthEndpointsRangedFound)" />
    </ItemGroup>
    <Error Condition="'@(_AuthEndpointsRangedMissing)' != ''"
           Text="$(MSBuildProjectName) imports AuthEndpoints.DependencyRange.targets but has no ProjectReference to @(_AuthEndpointsRangedMissing)." />
    <ItemGroup>
      <_AuthEndpointsRangedReference>
        <_Major>$([System.Version]::Parse($([System.String]::Copy('%(ProjectVersion)').Split('-')[0])).Major)</_Major>
      </_AuthEndpointsRangedReference>
      <_AuthEndpointsRangedReference>
        <ProjectVersion>[%(ProjectVersion), $([MSBuild]::Add(%(_Major), 1)).0.0)</ProjectVersion>
      </_AuthEndpointsRangedReference>
      <_ProjectReferencesWithVersions Remove="@(_AuthEndpointsRangedReference)" />
      <_ProjectReferencesWithVersions Include="@(_AuthEndpointsRangedReference)" />
      <_AuthEndpointsRangedName Remove="@(_AuthEndpointsRangedName)" />
      <_AuthEndpointsRangedReference Remove="@(_AuthEndpointsRangedReference)" />
      <_AuthEndpointsRangedFound Remove="@(_AuthEndpointsRangedFound)" />
    </ItemGroup>
  </Target>
</Project>
