<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Per-method completers stay callable through 4.x. Internal adapters reference them on purpose. -->
    <NoWarn>$(NoWarn);CS0618</NoWarn>
    <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
    <Description>Auth library that provides a set of minimal api endpoints to handle authentication actions</Description>
    <Version>4.3.0</Version>
    <Authors>madeyoga</Authors>
    <Company>madeyoga</Company>
    <PackageProjectUrl>https://authendpoints.harten.id</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/madeyoga/AuthEndpoints</RepositoryUrl>
    <PackageTags>auth;endpoints;aspnetcore;jwt;passkey;webauthn;2fa;identity</PackageTags>
    <PackageReleaseNotes>AuthEndpointsAntiforgeryOptions.BearerSchemes lists the bearer schemes that skip the RequireAntiforgery() CSRF check (default Identity.Bearer and Bearer, unchanged). RequireAntiforgery(allowBearer: false) requires the token from every caller. The authendpoints agent skill ships in the package under skills/authendpoints. Includes the 4.1.1 fix: password reset and email sign-in codes go only to the stored email address.</PackageReleaseNotes>
    <AssemblyVersion></AssemblyVersion>
    <FileVersion></FileVersion>
    <PackageRequireLicenseAcceptance>False</PackageRequireLicenseAcceptance>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AuthEndpoints.Tests" />
    <InternalsVisibleTo Include="AuthEndpoints.External.OAuth.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="buildTransitive\AuthEndpoints.targets" Pack="true" PackagePath="buildTransitive\" />
  </ItemGroup>

  <!--
    Agent skill shipped in the package (https://agentskills.io). Restore puts it at
    ~/.nuget/packages/authendpoints/<version>/skills/authendpoints/, matched to this version.
  -->
  <ItemGroup>
    <None Include="..\..\skills\authendpoints\**\*.md" Pack="true" PackagePath="skills\authendpoints\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\..\LICENSE">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.2" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.2" />
  </ItemGroup>

</Project>
